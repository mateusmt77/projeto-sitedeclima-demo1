db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/NOME_DO_BANCO?useSSL=false&serverTimezone=America/Sao_Paulo
db.user=SEU_USUARIO
db.password=SUA_SENHA
db.pool.maxConnections=10
